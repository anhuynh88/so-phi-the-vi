# Chép thành .env để chạy bản local: npm run local
HOST=127.0.0.1
PORT=8788
# Thư mục chứa database + file (mặc định app/data)
# SOPHI_DATA=D:\SoPhiData

# jwt = đăng nhập bằng form (/login.html), tài khoản trong database, đổi mật khẩu / quản lý người dùng ở /account.html.
#       Lần đầu: tài khoản trong LOCAL_USERS được nhập vào database và phải đổi mật khẩu.
# basic = hộp đăng nhập của trình duyệt, tài khoản chỉ trong LOCAL_USERS.
# Tạo dòng tài khoản bằng: npm run local:user -- ten-dang-nhap "mat-khau"
AUTH_MODE=jwt
# Khoá ký phiên (>= 32 ký tự ngẫu nhiên), thời hạn phiên (giờ)
JWT_SECRET=
SESSION_HOURS=12
LOCAL_USERS=
WRITER_EMAILS=*

# Nếu đưa máy local ra ngoài bằng Cloudflare Tunnel + Access thì dùng:
# AUTH_MODE=access
# ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# ACCESS_AUD=<AUD tag>

# Token cho agent đẩy file (>= 24 ký tự)
INGEST_TOKEN=

# Token nhận sao lưu từ Worker Cloudflare (giống secret BACKUP_TOKEN của Worker)
BACKUP_TOKEN=

# Webhook Adyen (chỉ cần nếu máy local nhận webhook trực tiếp)
ADYEN_WEBHOOK_USER=
ADYEN_WEBHOOK_PASS=
ADYEN_HMAC_KEY=
ADYEN_REPORT_API_KEY=
ADYEN_ACQ=adyen
