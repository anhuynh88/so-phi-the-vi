# Chép thành .env để chạy bản local: npm run local
HOST=127.0.0.1
PORT=8788
# Thư mục chứa database + file (mặc định app/data)
# SOPHI_DATA=D:\SoPhiData

# basic = tài khoản local (trình duyệt hỏi mật khẩu). Tạo dòng tài khoản bằng: npm run local:user -- email@congty.vn "mat-khau"
AUTH_MODE=basic
LOCAL_USERS=
WRITER_EMAILS=*

# Nếu đưa máy local ra ngoài bằng Cloudflare Tunnel + Access thì dùng:
# AUTH_MODE=access
# ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# ACCESS_AUD=<AUD tag>

# Token cho agent đẩy file (>= 24 ký tự)
INGEST_TOKEN=

# Webhook Adyen (chỉ cần nếu máy local nhận webhook trực tiếp)
ADYEN_WEBHOOK_USER=
ADYEN_WEBHOOK_PASS=
ADYEN_HMAC_KEY=
ADYEN_REPORT_API_KEY=
ADYEN_ACQ=adyen
