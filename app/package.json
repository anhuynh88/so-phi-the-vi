{
  "name": "so-phi",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "local": "node --env-file=.env --import tsx src/node.ts",
    "local:user": "tsx scripts/make-user.ts",
    "seed": "node scripts/seed.mjs",
    "typecheck": "tsc -p .",
    "test": "tsx --test test/*.test.ts"
  },
  "license": "UNLICENSED",
  "description": "Sổ phí thẻ & ví: web app (Cloudflare Workers hoặc chạy local)",
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "postal-mime": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.164.0"
  },
  "private": true,
  "type": "module"
}
